    "label": {
      "size": 14,
      "line": 1.4,
      "weight": 600,
      "tracking": 0
    },
    "caption": {
      "size": 12,
      "line": 1.5,
      "weight": 400,
      "tracking": 0
    },
    "code": {
      "size": 12,
      "line": 1.6,
      "weight": 400,
      "tracking": 0
    }
  },
  "component": {
    "button": {
      "height": 44,
      "radius": "lg",
      "background": "primary",
      "foreground": "primary-foreground",
      "hover": "primary-hover",
      "pressed": "primary-pressed"
    },
    "input": {
      "height": 44,
      "radius": "lg",
      "background": "background",
      "border": "input",
      "focus": "ring"
    },
    "card": {
      "radius": "xl",
      "background": "card",
      "foreground": "card-foreground",
      "border": "border"
    }
