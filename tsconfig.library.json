{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-library",
    "rootDir": "src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.library.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/components/ui/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx"
  ]
}
