{
  "name": "@untold/design-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -b && vite build && npm run build:library",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "tokens": "node scripts/create-tokens.mjs",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json && node scripts/package-theme.mjs",
    "figma:export": "node scripts/build-figma-plugin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist-library/index.d.ts",
      "import": "./dist-library/index.js"
    },
    "./theme.css": "./dist-library/theme.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist-library",
    "tokens.json",
    "DESIGN.md"
  ],
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  }
}
